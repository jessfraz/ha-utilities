#!/usr/bin/env bash
set -euo pipefail

cargo fmt --check
cargo clippy --locked --all --benches --tests --examples --all-features -- -D warnings
cargo test --locked --all-features
cargo build --locked --bins --examples
uv sync --frozen
uv run --frozen python scripts/build-integration --check-brand utilities
uv run --frozen ruff check custom_components tests_ha tests_web
uv run --frozen ruff format --check custom_components tests_ha tests_web
uv run --frozen ty check --error-on-warning
uv run --frozen playwright install chromium
uv run --frozen pytest tests_ha tests_web
actionlint
sh -n docker-entrypoint.sh
bash -n scripts/container-smoke.sh scripts/container-options.sh
shellcheck docker-entrypoint.sh scripts/check scripts/container-smoke.sh scripts/container-options.sh
